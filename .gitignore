# Build output
.build/
build/
dist/

# macOS
.DS_Store

# Configurazione dell'editor: locale, non del progetto
.vscode/

# Preferenze personali di Xcode: cambiano da persona a persona e non
# descrivono il progetto.
.swiftpm/
xcuserdata/

# Local overrides
*.local

# Chiavi e backup: non devono MAI finire nel repo, che è pubblico
*.p12
*.pem
*.key
# Chiavi di autenticazione Apple: la chiave APNs del companion iPhone è un .p8,
# e chi ce l'ha può mandare notifiche all'app a nome nostro.
*.p8
BACKUP-*
*chiave*
*private*

# Worktree delle sessioni Claude Code: repository a sé, non contenuto di questo.
.claude/

# Prodotto importando gli script come modulo, per le prove.
__pycache__/
